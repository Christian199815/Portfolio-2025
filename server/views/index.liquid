{% layout "server/layouts/base.liquid" %}

{% block content %}

<!-- Hero -->
<section id="hero-section" class="hero" aria-labelledby="hero-heading" data-animate="hero">
  <h1 id="hero-heading" class="sr-only">Chris Donker — Frontend Developer Portfolio</h1>

  <div class="hero__title-block">
    <span class="hero__eyebrow label-caps" data-hero="eyebrow">Chris</span>
    <h2 class="hero__title display-serif" data-hero="title">—Donker</h2>
    <div class="hero__stars" data-hero="stars" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0l1.8 5.5H16l-4.5 3.3 1.7 5.5L8 11l-5.2 3.3 1.7-5.5L0 5.5h6.2z"/></svg>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0l1.8 5.5H16l-4.5 3.3 1.7 5.5L8 11l-5.2 3.3 1.7-5.5L0 5.5h6.2z"/></svg>
    </div>
  </div>

  <div class="hero__grid">
    <aside class="hero__contact" data-hero="contact">
      <a href="mailto:chris@example.com" class="hero__contact-link" data-cursor-hover>chris@example.com</a>
      <a href="/contact" class="hero__contact-link" data-cursor-hover>Let's connect</a>
      <ul role="list" class="hero__social" aria-label="Social links">
        <li>
          <a href="https://www.linkedin.com/in/chris-donker/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" data-cursor-hover>
            <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
          </a>
        </li>
        <li>
          <a href="https://github.com/Christian199815" target="_blank" rel="noopener noreferrer" aria-label="GitHub" data-cursor-hover>
            <i class="fa-brands fa-github" aria-hidden="true"></i>
          </a>
        </li>
      </ul>
    </aside>

    <article class="hero__intro" data-hero="intro">
      <p class="hero__description">
        Hey, welcome to my portfolio! I'm Chris — a passionate builder of web and game experiences. Take a look around and check out the projects I've worked on.
      </p>
      <a href="/bento" class="btn btn--pill" data-cursor-hover>Read more</a>
    </article>
  </div>

  <ul class="hero__gallery" role="list" aria-label="Featured project previews">
    {% for stair in imageStairs %}
      <li class="hero-card hero-card--{{ forloop.index }}" data-hero="card" data-cursor-hover>
        <a href="{{ stair.link }}" aria-label="View project: {{ stair.alt }}">
          <img src="{{ stair.src }}" alt="{{ stair.alt }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" />
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

<!-- Process -->
<section id="process-section" class="process" aria-labelledby="process-heading" data-process-section data-reveal>
  <h2 id="process-heading" class="process__heading">A Methodical Process For Maximum Results.</h2>

  <div class="process__diagram" aria-label="Design process steps">
    <div class="process__circle" data-process-circle>
      <span class="label-caps">Discovery</span>
    </div>
    <div class="process__circle" data-process-circle>
      <span class="label-caps">Research</span>
    </div>
    <div class="process__circle process__circle--active" data-process-circle>
      <span class="label-caps">Design</span>
    </div>
    <div class="process__circle" data-process-circle>
      <span class="label-caps">Iteration</span>
    </div>
    <div class="process__circle" data-process-circle>
      <span class="label-caps">Ready</span>
    </div>
  </div>
</section>

<!-- Portfolio -->
<section id="portfolio-section" class="portfolio" aria-labelledby="portfolio-heading" data-reveal>
  <h2 id="portfolio-heading" class="portfolio__heading">Showcasing My Most Recent Projects.</h2>

  <ul class="portfolio__grid" role="list" data-reveal-stagger aria-label="Featured projects">
    {% for project in featuredProjects %}
      <li data-reveal-item>
        <article class="portfolio-card" data-cursor-hover>
          <a href="/project/{{ project.id }}" class="portfolio-card__link" aria-label="View {{ project.projectname }}">
            <figure class="portfolio-card__image">
              <img src="{{ project.projectFeaturedImage }}" alt="Featured image of {{ project.projectname }}" loading="lazy" />
            </figure>
            <div class="portfolio-card__meta">
              <h3 class="portfolio-card__title">{{ project.projectname }}</h3>
              <time class="portfolio-card__year" datetime="{{ project.projectDate }}">{{ project.projectDate }}</time>
            </div>
            <p class="portfolio-card__desc">{{ project.projectFeaturedText | default: 'Project description coming soon...' }}</p>
          </a>
        </article>
      </li>
    {% endfor %}
  </ul>
</section>

{% endblock %}
