{% layout "server/layouts/base.liquid" %}

{% block content %}
<article id="project" aria-labelledby="project-title">
  <section id="project-intro">
    <div>
      <h1 id="project-title">{{ project.projectname }}</h1>
      <nav aria-label="Breadcrumb" id="project-breadcrumb">
        <ol role="list">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          {% assign discipline_key = project.category | downcase | replace: ' ', '-' %}
          <li><a href="/bento?discipline={{ discipline_key }}" id="category-link" data-category="{{ project.category }}">{{ project.category }}</a></li>
          <li aria-hidden="true">/</li>
          <li><span id="project-name" aria-current="page">{{ project.projectname }}</span></li>
        </ol>
      </nav>
    </div>
  </section>

  <section id="project-info" aria-label="Project details">
    <img src="{{ project.projectFeaturedImage }}" alt="Featured image of {{ project.projectname }}" id="featured-image" loading="lazy" />

    <div id="project-info-details">
      <div id="project-tools">
        <div class="project-tools-primary">
          <h2>Tools</h2>
          <ul id="project-languages-list" role="list" aria-label="Technologies used">
            {% for language in project.projectLanguages %}
              {% render 'server/components/language-item/language-item.liquid', language: language %}
            {% endfor %}
          </ul>
        </div>

        <div class="project-tools-secondary">
          {% if project.projectQuote %}
            <blockquote>
              <p>{{ project.projectQuote }}</p>
            </blockquote>
          {% endif %}

          {% if project.link %} 
            <a href="{{ project.link }}" target="_blank" rel="noopener noreferrer" class="project-link" aria-label="Visit {{ project.projectname }} website (opens in new tab)">Visit website</a>
          {% endif %}
        </div>
      </div>

      <div id="project-copy">
        <p id="project-description">{{ project.projectBodyText | default: "Project description coming soon..." }}</p>
      </div>
    </div>
  </section>



  {% if project.projectProgress.size > 0 %}
    <section id="project-progress" class="project-progress" aria-labelledby="progress-heading">
      <h2 id="progress-heading">Project information</h2>
      
      {% for progress in project.projectProgress %}
        <article class="progress-item" aria-labelledby="progress-{{ forloop.index }}">
          <h3 id="progress-{{ forloop.index }}">{{ progress.progressName }}</h3>
          
          {% if progress.progressBodyText %}
            <p class="progress-body">
              {{ progress.progressBodyText }}
            </p>
          {% endif %}
          
          {% if progress.progressContent.size > 0 %}
            <div class="progress-carousel" data-progress-carousel role="region" aria-roledescription="carousel" aria-label="{{ progress.progressName }} media carousel">
              <button type="button" class="progress-nav progress-nav--prev" data-progress-prev aria-label="Previous media">&#10094;</button>
              <ul class="progress-content" data-progress-track role="list" aria-label="Media items">
                {% for content in progress.progressContent %}
                  <li class="content-item" role="group" aria-roledescription="slide" aria-label="Media {{ forloop.index }} of {{ progress.progressContent.size }}">
                    {% if content.duration %}
                      <p class="duration">
                        <span>Duration: {{ content.duration }}</span>
                      </p>
                    {% endif %}
                    
                    {% if content.url %}
                      <div class="content-media">
                        {% assign url_extension = content.url | split: '.' | last | downcase %}
                        
                        {% if url_extension == 'jpg' or url_extension == 'jpeg' or url_extension == 'png' or url_extension == 'gif' or url_extension == 'webp' %}
                          <img src="{{ content.url }}" alt="Progress media for {{ progress.progressName }}" data-pop-image loading="lazy" />
                        {% elsif url_extension == 'mp4' or url_extension == 'webm' or url_extension == 'mov' %}
                          <video controls aria-label="Video for {{ progress.progressName }}">
                            <source src="{{ content.url }}" type="video/{{ url_extension }}">
                            Your browser does not support video playback.
                          </video>
                        {% else %}
                          <a href="{{ content.url }}" target="_blank" rel="noopener noreferrer" class="content-link" aria-label="View media (opens in new tab)">View Media</a>
                        {% endif %}
                      </div>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
              <button type="button" class="progress-nav progress-nav--next" data-progress-next aria-label="Next media">&#10095;</button>
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </section>
  {% endif %}

  {% if project.projectImages and project.projectImages.size > 1 %}
    <section id="project-gallery" aria-labelledby="gallery-heading">
      <h2 id="gallery-heading">Image Gallery</h2>
      <div class="gallery-carousel" data-gallery-carousel role="region" aria-roledescription="carousel" aria-label="Project image gallery">
        <button type="button" class="gallery-nav gallery-nav--prev" data-gallery-prev aria-label="Previous images">&#10094;</button>
        <div class="gallery-track-container">
          <ul class="gallery-track" data-gallery-track role="list">
            {% for image in project.projectImages %}
              <li class="gallery-card" role="group" aria-roledescription="slide" aria-label="Image {{ forloop.index }} of {{ project.projectImages.size }}">
                <img src="{{ image }}" alt="{{ project.projectname }} gallery image {{ forloop.index }}" loading="lazy" data-pop-image />
              </li>
            {% endfor %}
          </ul>
        </div>
        <button type="button" class="gallery-nav gallery-nav--next" data-gallery-next aria-label="Next images">&#10095;</button>
      </div>
    </section>
  {% endif %}
</article>

{% comment %} {% render '../../components/under-construction/under-construction.liquid' %} {% endcomment %}

{% endblock %}
