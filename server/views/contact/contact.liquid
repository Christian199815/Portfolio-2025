{% layout "server/layouts/base.liquid" %}

{% block content %}

<section class="page" aria-labelledby="contact-heading">
    <div>
        <h1 id="contact-heading">Let's Connect!</h1>
        {% comment %} <h2>Contact </h2> {% endcomment %}
        <p>Thank you for taking the time to visit my portfolio.
            I hope it gave you a good impression of my skills, creativity, and the kind of work I enjoy doing. It means a lot that you explored what I've been working on, and I'm always open to new opportunities, collaborations, or just a friendly chat about shared interests.
             <br> I look forward to connecting with you—don't hesitate to reach out!</p>
        <hr aria-hidden="true" />
        {% comment %} <form data-form>
            <div>
                <label for="email">Email Address</label>
                <input type="email" data-email name="email" required>
            </div>

            <div>
                <label for="message">Message</label>
                <textarea data-message name="message" required></textarea>
            </div>
                
            <button type="submit" data-submit>Submit</button>
                <div data-feedback></div>
                <div data-captcha>
                    <h3>Please verify you're not a robot</h3>
                    <div data-captcha-box></div>
                    <div>
                        <label for="captchaInput">Enter the code above</label>
                        <input type="text" data-captcha-input name="captchaInput">
                    </div>
                    <button type="button" data-verify>Verify</button>
                </div>
        </form> {% endcomment %}
        <a href="mailto:cchdonkervault@gmail.com" class="contact-email-link" aria-label="Send email to Chris">Let's connect with me</a>
    </div>
        
    <aside aria-label="Photo gallery of Chris">
        <ul data-carousel role="list" aria-label="Photo carousel">
            <li data-slide class="active" role="group" aria-roledescription="slide" aria-label="Photo 1 of 3">
                <img src="/public/images/Chris-Hoofd.webp" alt="Portrait photo of Chris" loading="lazy" />
            </li>
            <li data-slide role="group" aria-roledescription="slide" aria-label="Photo 2 of 3">
                <img src="/public/images/berg-chris.webp" alt="Chris hiking in the mountains" loading="lazy" />
            </li>
            <li data-slide role="group" aria-roledescription="slide" aria-label="Photo 3 of 3">
                <img src="/public/images/adventure-chris.webp" alt="Chris on an outdoor adventure" loading="lazy" />
            </li>
        </ul>
    </aside>
</section>

{% comment %} {% render '../../components/under-construction/under-construction.liquid' %} {% endcomment %}


{% endblock %}
