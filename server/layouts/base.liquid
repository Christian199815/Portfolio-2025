<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  {% block head %}
    <title>{{ title }}</title>
  {% endblock %}
  <link rel="stylesheet" href="/index.css">
  <script src="/index.js" defer></script>
  {% block styles %}{% endblock %}
  {% block scripts %}{% endblock %}
</head>

<body data-auto-init-popovers>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <a href="#primary-navigation" class="skip-link">Skip to navigation</a>
  <a href="#site-footer" class="skip-link">Skip to footer</a>

  <div id="sr-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
  <div id="sr-announcer-assertive" class="sr-only" aria-live="assertive" aria-atomic="true"></div>

  {% render '../components/settings-menu/settings-menu.liquid' %}

  <header role="banner" class="site-header" data-animate="header">
    <nav id="primary-navigation" class="site-nav" aria-label="Primary navigation">
      <a href="/" class="site-logo" aria-label="Chris — Home">Chris</a>

      <ul role="list" class="site-nav__links">
        <li><a href="/#skills-section">Skills</a></li>
        <li><a href="/bento">Work</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>

      <a href="/contact" class="site-nav__cta" data-cursor-hover>Get in touch</a>
    </nav>
  </header>

  <main id="main-content" role="main" tabindex="-1">
    {% block content %}{% endblock %}
  </main>

  <footer id="site-footer" class="site-footer" role="contentinfo" data-animate="footer">
    <div class="site-footer__hero">
      <h2 class="site-footer__title display-serif" data-footer-reveal>
        Get in <em>touch</em>
      </h2>
      <a href="mailto:chris@example.com" class="site-footer__email" data-footer-reveal data-cursor-hover>
        chris@example.com
      </a>

      <ul role="list" class="site-footer__social" aria-label="Social media links" data-footer-reveal>
        <li>
          <a href="https://www.linkedin.com/in/chris-donker/" target="_blank" rel="noopener noreferrer" aria-label="Chris on LinkedIn (opens in new tab)" data-cursor-hover>
            <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
          </a>
        </li>
        <li>
          <a href="https://github.com/Christian199815" target="_blank" rel="noopener noreferrer" aria-label="Chris on GitHub (opens in new tab)" data-cursor-hover>
            <i class="fa-brands fa-github" aria-hidden="true"></i>
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__bar" data-footer-reveal>
      <a href="/" class="site-footer__logo" aria-label="Chris — Home">Chris</a>

      <nav aria-label="Footer navigation">
        <ul role="list" class="site-footer__nav">
          <li><a href="/#skills-section">Skills</a></li>
          <li><a href="/bento">Work</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <p class="site-footer__copy"><small>&copy; Chris 2025</small></p>
    </div>
  </footer>

</body>
</html>
